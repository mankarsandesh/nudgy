{
  "manifest_version": 3,
  "name": "Little Nudges – Animated Reminders",
  "short_name": "Little Nudges",
  "version": "1.1.0",
  "description": "Free animated reminders for anything you need to remember, plus water, stretch, eye-rest and break alerts on your schedule.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Little Nudges reminders",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications"]
}
